# Development-specific environment variables

# Development FHIR server URL (overrides the default)
# Using local proxy to avoid CORS issues with hapi.fhir.org
VITE_FHIR_BASE_URL=http://localhost:8080/fhir

# Agent/AI API base URL (for global search, clinical docs import, digital twin)
VITE_AGENT_API_BASE_URL=http://localhost:8080

# SSE (Server-Sent Events) endpoint for real-time notifications
VITE_SSE_BASE_URL=http://localhost:8080

# Development API key if your FHIR server requires one
VITE_API_KEY=your_api_key_here
