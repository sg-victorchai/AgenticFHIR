# Example environment variables for the FHIR web application
# See PROFILES.md for detailed information about available profiles

# COPY THIS FILE TO CREATE NEW PROFILES:
# - .env.development  (default - local development)
# - .env.azure        (Azure FHIR server)
# - .env.healthx      (HealthX FHIR server)
# - .env.production   (production deployment)

# ============================================================================
# FHIR SERVER CONFIGURATION
# ============================================================================

# FHIR server base URL
# Examples:
#   http://20.212.110.174/fhir                                          (Azure)
#   https://api.healthx.sg/fhir/r5/2807f247634c4f3c941568d460835a71   (HealthX)
#   http://localhost:8080/fhir                                          (Local)
VITE_FHIR_BASE_URL=https://api.example.com/fhir/r5/your-tenant-id

# SSE (Server-Sent Events) endpoint for real-time notifications
# Examples:
#   http://20.212.110.174                                              (Azure)
#   https://api.healthx.sg                                             (HealthX)
#   http://localhost:8080                                              (Local)
VITE_SSE_BASE_URL=http://localhost:8080

# API key for authentication with the FHIR server
# This is sent as the 'x-api-key' HTTP header
# Example: 2552c5fa-865b-4db8-8f2c-87580dbe5f0d
VITE_API_KEY=your_api_key_here

# ============================================================================
# AGENT/AI API CONFIGURATION
# ============================================================================

# Agent/AI API base URL (without /fhir path)
# Used for:
#   - Global search (/api/ai/hybrid-search)
#   - Clinical docs import (/api/persona/DataPipelinePersona/...)
#   - Digital twin missions (/api/agent/AgentPersona/...)
# Examples:
#   http://20.212.110.174                                              (Azure)
#   https://api.healthx.sg                                             (HealthX)
#   http://localhost:8080                                              (Local)
VITE_AGENT_API_BASE_URL=https://api.example.com